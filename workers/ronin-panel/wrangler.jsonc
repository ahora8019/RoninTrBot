/**
 * RoninTrBot Telegram control-panel worker.
 * Deployed via .github/workflows/deploy-worker.yml (Wrangler in CI);
 * manual API uploads are superseded. Secrets are NEVER in this file.
 * KV: USERS_KV holds broadcast audience state (see docs/security/secrets-and-access.md).
 */
{
  "name": "ronintrbot",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "USERS_KV", "id": "97fdd4c0960e4b60bedee671172b52b7" }
  ],
  "vars": {
    // OWNER_TELEGRAM_ID / ADMIN_TELEGRAM_IDS are injected by CI from
    // environment-specific sources (see deploy workflow); never committed.
  },
  "observability": { "enabled": true }
}
