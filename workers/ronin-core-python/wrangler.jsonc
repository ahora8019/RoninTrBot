{
  "name": "ronintrbot-python-core-preview",
  "main": "entry.py",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "PAPER_DB",
      "database_name": "ronintrbot-paper-preview",
      "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
